# ============================================================
# scei_qr_api - Variables de entorno (plantilla)
# Copia este archivo a .env y completa los valores.
# ============================================================

# --- Base de datos (Neon: pooled para la app, direct para migraciones) ---
# Pooled: host con "-pooler" (uso de la aplicación)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
# Direct: host SIN "-pooler" (usado por prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Auth ---
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-este-secreto"
# Expiración del access token (contrato Flutter: cliente valida `exp`)
JWT_EXPIRATION="8h"

# --- Servidor ---
PORT=3000
# CORS: origins separados por coma. "*" solo en desarrollo.
CORS_ORIGIN="*"

# --- Fotos de incidencias (HU-AL-08) ---
# local | s3 | cloudinary (s3/cloudinary pendientes Iteración 5)
STORAGE_DRIVER="local"
# Carpeta física cuando STORAGE_DRIVER=local
UPLOAD_DIR="uploads"

# --- Push notifications (HU-AL-09, HU-ST-08) - Iteración 5 ---
# JSON de la service account de Firebase codificado en base64.
# node -e "console.log(require('fs').readFileSync('serviceAccount.json','utf8').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT=""
